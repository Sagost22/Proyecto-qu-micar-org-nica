<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ibuprofeno — Proyecto Científico</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --white:       #ffffff;
      --off-white:   #f8f9fb;
      --light-gray:  #eef1f6;
      --mid-gray:    #d1d9e6;
      --dark-gray:   #4a4f5a;
      --text:        #1a1c22;
      --blue-primary:#1a5fa8;
      --blue-light:  #3a7fc1;
      --blue-pale:   #e8f0fb;
      --blue-border: #b8cfec;
      --accent:      #0d4580;
      --font-serif:  'Times New Roman', 'Playfair Display', Georgia, serif;
      --font-sans:   'Inter', Arial, sans-serif;
      --shadow-sm:   0 1px 4px rgba(0,0,0,.08);
      --shadow-md:   0 4px 16px rgba(0,0,0,.1);
      --radius:      6px;
      --transition:  .25s ease;
    }

    html { scroll-behavior: smooth; }
    body { font-family: var(--font-serif); background: var(--white); color: var(--text); font-size: 16px; line-height: 1.75; }
    h1,h2,h3,h4,h5 { font-family: var(--font-serif); line-height: 1.3; }
    p,li,td,th,figcaption { font-family: var(--font-serif); }
    a { color: var(--blue-primary); text-decoration: none; }
    a:hover { text-decoration: underline; }
    img { max-width: 100%; display: block; }

    /* HEADER */
    .site-header { background: var(--white); border-bottom: 3px solid var(--blue-primary); padding: 0; position: sticky; top: 0; z-index: 100; box-shadow: var(--shadow-sm); }
    .header-inner { max-width: 1200px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 10px 24px; gap: 16px; }
    .site-logo { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
    .logo-icon { width: 46px; height: 46px; background: var(--blue-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 22px; font-family: var(--font-serif); font-weight: 700; letter-spacing: -1px; flex-shrink: 0; }
    .logo-text { display: flex; flex-direction: column; }
    .logo-title { font-family: var(--font-serif); font-size: 1.05rem; font-weight: 700; color: var(--accent); line-height: 1.15; }
    .logo-sub { font-family: var(--font-sans); font-size: 0.7rem; color: var(--dark-gray); font-weight: 400; letter-spacing: .04em; text-transform: uppercase; }

    /* NAV */
    nav.main-nav { background: var(--blue-primary); border-bottom: 2px solid var(--accent); }
    .nav-inner { max-width: 1200px; margin: 0 auto; display: flex; overflow-x: auto; scrollbar-width: none; }
    .nav-inner::-webkit-scrollbar { display: none; }
    .nav-btn { background: none; border: none; cursor: pointer; font-family: var(--font-serif); font-size: 0.82rem; color: rgba(255,255,255,.82); padding: 12px 18px; white-space: nowrap; position: relative; transition: color var(--transition), background var(--transition); letter-spacing: .01em; border-bottom: 3px solid transparent; }
    .nav-btn:hover { color: #fff; background: rgba(255,255,255,.1); }
    .nav-btn.active { color: #fff; background: rgba(255,255,255,.14); border-bottom-color: #fff; font-weight: 600; }

    /* MAIN */
    main { min-height: 80vh; }
    .page { display: none; }
    .page.active { display: block; }
    .content-wrap { max-width: 1100px; margin: 0 auto; padding: 48px 24px 64px; }

    /* HERO */
    .hero-banner { background: linear-gradient(135deg, var(--blue-pale) 0%, #ddeeff 50%, #f0f6ff 100%); border-bottom: 2px solid var(--blue-border); padding: 60px 24px 48px; text-align: center; }
    .hero-tag { display: inline-block; background: var(--blue-primary); color: #fff; font-family: var(--font-sans); font-size: 0.7rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; padding: 4px 14px; border-radius: 20px; margin-bottom: 18px; }
    .hero-title { font-family: var(--font-serif); font-size: clamp(1.8rem, 4vw, 2.8rem); color: var(--accent); margin-bottom: 8px; font-style: italic; font-weight: 700; }
    .hero-subtitle { font-family: var(--font-serif); font-size: clamp(1rem, 2.5vw, 1.4rem); color: var(--blue-primary); margin-bottom: 10px; font-weight: 400; }
    .hero-drug { font-family: var(--font-serif); font-size: clamp(2rem, 6vw, 3.8rem); font-weight: 700; color: var(--blue-primary); letter-spacing: .04em; margin: 12px 0 24px; line-height: 1.1; }
    .hero-intro { max-width: 720px; margin: 0 auto 32px; font-size: 1rem; color: var(--dark-gray); line-height: 1.8; }

    /* TEAM CARD */
    .team-card { background: var(--white); border: 1px solid var(--blue-border); border-radius: var(--radius); padding: 32px 36px; max-width: 680px; margin: 0 auto 40px; box-shadow: var(--shadow-sm); }
    .team-card h3 { font-family: var(--font-serif); font-size: 1rem; color: var(--blue-primary); border-bottom: 1px solid var(--mid-gray); padding-bottom: 8px; margin-bottom: 18px; text-transform: uppercase; letter-spacing: .07em; font-weight: 600; }
    .team-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 32px; }
    .team-field { display: flex; flex-direction: column; gap: 3px; }
    .team-field label { font-family: var(--font-sans); font-size: 0.68rem; font-weight: 600; color: var(--blue-primary); text-transform: uppercase; letter-spacing: .08em; }
    .team-field span { font-family: var(--font-serif); font-size: 0.95rem; color: var(--dark-gray); border-bottom: 1px dashed var(--mid-gray); padding-bottom: 4px; min-height: 26px; }

    /* PHOTO PLACEHOLDERS & LAB IMAGES */
    .photo-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin: 28px 0; }
    .photo-card { background: var(--white); border: 1px solid var(--blue-border); border-radius: var(--radius); padding: 12px; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; }
    .photo-frame { width: 100%; height: 380px; background: #000; border-radius: calc(var(--radius) - 2px); overflow: hidden; display: flex; align-items: center; justify-content: center; }
    .lab-img { width: 100%; height: 100%; object-fit: cover; object-position: center; transition: transform 0.3s ease; }
    .photo-frame:hover .lab-img { transform: scale(1.02); }
    .photo-placeholder { background: var(--light-gray); border: 2px dashed var(--blue-border); border-radius: var(--radius); display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 200px; gap: 10px; padding: 24px; }
    .photo-placeholder .ph-icon { width: 52px; height: 52px; background: var(--blue-pale); border: 2px solid var(--blue-border); border-radius: 50%; display: flex; align-items: center; justify-content: center; }
    .photo-placeholder .ph-icon svg { width: 26px; height: 26px; stroke: var(--blue-primary); fill: none; }
    .photo-placeholder p { font-family: var(--font-sans); font-size: 0.78rem; color: var(--dark-gray); text-align: center; }
    .photo-placeholder p strong { display: block; color: var(--blue-primary); font-size: 0.82rem; margin-bottom: 4px; }
    .apa-caption { font-family: var(--font-serif); font-size: 0.78rem; color: var(--dark-gray); font-style: italic; margin-top: 8px; line-height: 1.5; border-top: 1px solid var(--mid-gray); padding-top: 6px; }

    /* SECTION HEADINGS */
    .section-heading { font-family: var(--font-serif); font-size: 1.55rem; color: var(--accent); margin-bottom: 6px; padding-bottom: 10px; border-bottom: 2px solid var(--blue-border); font-weight: 700; }
    .section-lead { font-size: 0.95rem; color: var(--dark-gray); margin-bottom: 28px; max-width: 800px; }
    .subsection-heading { font-family: var(--font-serif); font-size: 1.15rem; color: var(--blue-primary); margin: 32px 0 12px; font-weight: 700; }

    /* INTRO BOX */
    .intro-box { background: var(--blue-pale); border-left: 4px solid var(--blue-primary); border-radius: 0 var(--radius) var(--radius) 0; padding: 22px 28px; margin: 28px 0; }
    .intro-box p { font-size: 0.96rem; line-height: 1.85; color: var(--text); }

    /* TABLES */
    .styled-table { width: 100%; border-collapse: collapse; margin: 20px 0 8px; font-size: 0.9rem; box-shadow: var(--shadow-sm); border-radius: var(--radius); overflow: hidden; }
    .styled-table thead tr { background: var(--blue-primary); color: #fff; }
    .styled-table th { padding: 12px 16px; text-align: left; font-family: var(--font-serif); font-weight: 600; font-size: 0.88rem; letter-spacing: .02em; }
    .styled-table td { padding: 11px 16px; border-bottom: 1px solid var(--mid-gray); color: var(--text); font-size: 0.9rem; }
    .styled-table tbody tr:nth-child(even) { background: var(--blue-pale); }
    .styled-table tbody tr:last-child td { border-bottom: none; }
    .styled-table tbody tr:hover { background: #dceaf8; }
    .table-apa { font-family: var(--font-serif); font-size: 0.78rem; color: var(--dark-gray); font-style: italic; margin-top: 6px; padding-left: 2px; }

    /* INFOGRAPHIC */
    .infographic { background: var(--white); border: 1px solid var(--blue-border); border-radius: 10px; padding: 40px 36px; margin: 28px 0; box-shadow: var(--shadow-md); }
    .info-title { font-family: var(--font-serif); font-size: 1.35rem; color: var(--accent); text-align: center; margin-bottom: 32px; font-weight: 700; letter-spacing: .02em; }
    .info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px; }
    .info-card { background: var(--off-white); border: 1px solid var(--blue-border); border-radius: 8px; padding: 22px 18px; text-align: center; transition: transform var(--transition), box-shadow var(--transition); }
    .info-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
    .info-card .card-icon { width: 60px; height: 60px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; font-size: 1.6rem; }
    .info-card h4 { font-family: var(--font-serif); font-size: 0.95rem; color: var(--accent); margin-bottom: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
    .info-card ul { list-style: none; padding: 0; text-align: left; }
    .info-card ul li { font-size: 0.84rem; color: var(--dark-gray); padding: 4px 0; border-bottom: 1px solid var(--mid-gray); line-height: 1.5; display: flex; gap: 6px; align-items: flex-start; }
    .info-card ul li::before { content: '▸'; color: var(--blue-light); flex-shrink: 0; margin-top: 1px; }
    .info-card ul li:last-child { border-bottom: none; }
    .card-causas .card-icon { background: #fff3e0; }
    .card-sintomas .card-icon { background: #fce4ec; }
    .card-efectos .card-icon { background: #e8f5e9; }
    .card-trat .card-icon { background: var(--blue-pale); }

    /* PROP HIGHLIGHT */
    .prop-highlight { background: var(--blue-pale); border: 1px solid var(--blue-border); border-radius: var(--radius); padding: 20px 28px; margin: 24px 0; display: flex; flex-wrap: wrap; gap: 28px; }
    .prop-highlight-item { display: flex; flex-direction: column; gap: 3px; }
    .prop-highlight-item .label { font-family: var(--font-sans); font-size: 0.68rem; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--blue-primary); }
    .prop-highlight-item .value { font-family: var(--font-serif); font-size: 0.96rem; color: var(--text); }

    /* IUPAC BANNER */
    .iupac-banner { background: var(--accent); color: #fff; border-radius: var(--radius); padding: 20px 28px; margin: 20px 0; display: flex; flex-direction: column; gap: 6px; }
    .iupac-banner .iupac-label { font-family: var(--font-sans); font-size: 0.68rem; font-weight: 600; text-transform: uppercase; letter-spacing: .1em; color: rgba(255,255,255,.65); }
    .iupac-banner .iupac-name { font-family: var(--font-serif); font-size: 1.05rem; font-style: italic; color: #fff; }

    /* CAS TAG */
    .cas-tag { display: inline-block; background: var(--blue-primary); color: #fff; font-family: var(--font-sans); font-size: 0.78rem; font-weight: 600; letter-spacing: .04em; padding: 4px 12px; border-radius: 3px; margin-right: 8px; }

    /* PHARMA CARDS */
    .pharma-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 22px; margin: 24px 0; }
    .pharma-card { background: var(--white); border: 1px solid var(--blue-border); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-sm); transition: transform var(--transition), box-shadow var(--transition); }
    .pharma-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
    .pharma-card-img { background: var(--light-gray); border-bottom: 1px solid var(--mid-gray); display: flex; align-items: center; justify-content: center; height: 150px; font-size: 3rem; }
    .pharma-card-body { padding: 16px 18px; }
    .pharma-card-body h4 { font-family: var(--font-serif); font-size: 1rem; color: var(--accent); margin-bottom: 8px; font-weight: 700; }
    .pharma-card-body p { font-size: 0.86rem; color: var(--dark-gray); line-height: 1.65; }
    .pharma-card-apa { font-size: 0.72rem; font-style: italic; color: #888; margin-top: 10px; border-top: 1px solid var(--mid-gray); padding-top: 8px; }

    /* MOLECULAR */
    .mol-placeholder { background: var(--light-gray); border: 2px dashed var(--blue-border); border-radius: var(--radius); min-height: 300px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; padding: 32px; margin: 24px 0; text-align: center; }
    .mol-placeholder .mol-icon { font-size: 4rem; line-height: 1; }
    .mol-placeholder p { font-size: 0.85rem; color: var(--dark-gray); max-width: 420px; }
    .functional-groups { display: flex; flex-wrap: wrap; gap: 12px; margin: 20px 0; }
    .fg-badge { background: var(--blue-pale); border: 1px solid var(--blue-border); border-radius: 20px; padding: 6px 16px; font-family: var(--font-serif); font-size: 0.84rem; color: var(--accent); display: flex; align-items: center; gap: 6px; }
    .fg-badge .fg-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }

    /* MODEL ANGLES */
    .model-angles { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; margin: 24px 0; }
    .angle-card { background: var(--white); border: 1px solid var(--blue-border); border-radius: var(--radius); padding: 12px; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; }
    .angle-frame { width: 100%; height: 280px; background: #f9fbfd; border-radius: calc(var(--radius) - 2px); border: 1px solid var(--mid-gray); overflow: hidden; display: flex; align-items: center; justify-content: center; }
    .angle-img { width: 100%; height: 100%; object-fit: cover; object-position: center; transition: transform 0.3s ease; }
    .angle-frame:hover .angle-img { transform: scale(1.03); }
    .angle-placeholder { background: var(--light-gray); border: 2px dashed var(--blue-border); border-radius: var(--radius); min-height: 230px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 20px 16px; text-align: center; }
    .angle-placeholder .ang-icon { font-size: 2.4rem; }
    .angle-placeholder .ang-label { font-family: var(--font-sans); font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--blue-primary); }
    .angle-placeholder .ang-desc { font-size: 0.78rem; color: var(--dark-gray); text-align: center; }

    /* ARTICLE CARDS */
    .article-card { background: var(--white); border: 1px solid var(--blue-border); border-radius: var(--radius); padding: 28px 30px; margin-bottom: 24px; box-shadow: var(--shadow-sm); border-left: 5px solid var(--blue-primary); }
    .article-card .art-type { font-family: var(--font-sans); font-size: 0.68rem; font-weight: 600; text-transform: uppercase; letter-spacing: .1em; color: var(--blue-light); margin-bottom: 8px; }
    .article-card h3 { font-family: var(--font-serif); font-size: 1.05rem; color: var(--accent); margin-bottom: 10px; font-style: italic; line-height: 1.45; }
    .article-card .art-meta { font-family: var(--font-sans); font-size: 0.78rem; color: var(--dark-gray); margin-bottom: 14px; }
    .article-card p { font-size: 0.9rem; line-height: 1.75; color: var(--text); margin-bottom: 12px; }
    .art-impact { background: var(--blue-pale); border-radius: var(--radius); padding: 14px 18px; margin-top: 14px; }
    .art-impact strong { font-family: var(--font-serif); font-size: 0.85rem; color: var(--blue-primary); display: block; margin-bottom: 4px; }
    .art-impact p { font-size: 0.85rem; margin-bottom: 0; color: var(--dark-gray); }

    /* APP CARDS */
    .app-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin: 24px 0; }
    .app-card { background: var(--white); border: 1px solid var(--blue-border); border-radius: var(--radius); padding: 24px 22px; box-shadow: var(--shadow-sm); }
    .app-card .app-icon { font-size: 2rem; margin-bottom: 12px; }
    .app-card h4 { font-family: var(--font-serif); font-size: 1rem; color: var(--accent); margin-bottom: 10px; font-weight: 700; }
    .app-card p { font-size: 0.88rem; color: var(--dark-gray); line-height: 1.7; }

    /* CONCLUSIONS (EMPTY) */
    .conclusion-empty { border: 2px dashed var(--mid-gray); border-radius: var(--radius); min-height: 260px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 40px; margin: 32px 0; text-align: center; }
    .conclusion-empty .empty-icon { font-size: 2.4rem; opacity: .5; }
    .conclusion-empty p { font-family: var(--font-sans); font-size: 0.82rem; color: #bbb; }

    /* REFERENCES */
    .references-list { list-style: decimal; padding-left: 28px; }
    .references-list li { padding: 14px 0 14px 8px; border-bottom: 1px solid var(--light-gray); font-size: 0.9rem; line-height: 1.8; color: var(--text); }
    .references-list li:last-child { border-bottom: none; }

    /* FOOTER */
    footer { background: var(--accent); color: rgba(255,255,255,.75); padding: 28px 24px; text-align: center; margin-top: 60px; }
    footer p { font-family: var(--font-sans); font-size: 0.78rem; line-height: 1.7; }
    footer strong { color: #fff; }

    /* UTILS */
    .section-divider { border: none; border-top: 1px solid var(--mid-gray); margin: 36px 0; }
    .page-title-row { display: flex; align-items: flex-end; gap: 14px; margin-bottom: 28px; padding-bottom: 14px; border-bottom: 3px solid var(--blue-primary); flex-wrap: wrap; }
    .page-num { font-family: var(--font-sans); font-size: 2.2rem; font-weight: 700; color: var(--blue-border); line-height: 1; flex-shrink: 0; }
    .page-title-row h2 { font-family: var(--font-serif); font-size: clamp(1.3rem, 3vw, 1.9rem); color: var(--accent); font-weight: 700; line-height: 1.2; }
    .page-title-row p { font-family: var(--font-sans); font-size: 0.78rem; color: var(--blue-light); font-weight: 500; letter-spacing: .05em; text-transform: uppercase; }

    /* RESPONSIVE */
    @media (max-width: 768px) {
      .info-grid { grid-template-columns: 1fr; }
      .prop-highlight { flex-direction: column; gap: 14px; }
      .model-angles { grid-template-columns: 1fr 1fr; }
      .content-wrap { padding: 28px 16px 48px; }
      .infographic { padding: 24px 16px; }
      .team-card { padding: 22px 18px; }
      .team-grid { grid-template-columns: 1fr; }
      .article-card { padding: 20px 18px; }
    }
    @media (max-width: 480px) {
      .model-angles { grid-template-columns: 1fr; }
      .hero-banner { padding: 36px 16px 30px; }
    }
  </style>
</head>
